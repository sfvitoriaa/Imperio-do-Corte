// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Empresa {
  id            Int            @id @default(autoincrement())
  nome          String
  cnpj          String         @unique
  telefone      String?
  ativa         Boolean        @default(true)
  criadoEm      DateTime       @default(now())
  clientes      Cliente[]
  profissionais Profissional[]
  servicos      Servico[]
  agendamentos  Agendamento[]
  horarios      HorarioProfissional[]
  indisponibilidades IndisponibilidadeProfissional[]
  pagamentos Pagamento[]
  notificacoes NotificacaoInterna[]

  @@map("empresas")
}

model Cliente {
  id           Int           @id @default(autoincrement())
  nome         String
  telefone     String
  criadoEm     DateTime      @default(now())
  empresa      Empresa?      @relation(fields: [empresaId], references: [id])
  empresaId    Int?
  agendamentos Agendamento[]

  @@unique([empresaId, telefone])
  @@map("clientes")
}

model Profissional {
  id           Int           @id @default(autoincrement())
  nome         String
  telefone     String?
  ativo        Boolean       @default(true)
  empresa      Empresa?      @relation(fields: [empresaId], references: [id])
  empresaId    Int?
  agendamentos Agendamento[]
  horarios     HorarioProfissional[]
  indisponibilidades IndisponibilidadeProfissional[]

  @@map("profissionais")
}

model HorarioProfissional {
  id             Int                    @id @default(autoincrement())
  diaSemana      Int
  inicio         String
  fim            String
  profissional   Profissional           @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  profissionalId Int
  empresa        Empresa?               @relation(fields: [empresaId], references: [id])
  empresaId      Int?
  intervalos     IntervaloHorario[]

  @@unique([profissionalId, empresaId, diaSemana])
  @@map("horarios_profissionais")
}

model IntervaloHorario {
  id        Int                @id @default(autoincrement())
  inicio    String
  fim       String
  horario   HorarioProfissional @relation(fields: [horarioId], references: [id], onDelete: Cascade)
  horarioId Int

  @@map("intervalos_horarios")
}

model IndisponibilidadeProfissional {
  id             Int          @id @default(autoincrement())
  tipo           String
  inicio         DateTime
  fim            DateTime
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  profissionalId Int
  empresa        Empresa?     @relation(fields: [empresaId], references: [id])
  empresaId      Int?

  @@map("indisponibilidades_profissionais")
}

model Servico {
  id           Int                  @id @default(autoincrement())
  nome         String
  descricao    String?
  preco        Float
  duracaoMin   Int
  ativo        Boolean              @default(true)
  empresa      Empresa?             @relation(fields: [empresaId], references: [id])
  empresaId    Int?
  agendamentos AgendamentoServico[]

  @@map("servicos")
}

enum StatusAgendamento {
  PENDENTE
  AGENDADO
  CONCLUIDO
  CANCELADO
  FALTOU
  NAO_COMPARECEU
}

model Agendamento {
  id             Int                  @id @default(autoincrement())
  inicio         DateTime
  fim            DateTime
  status         StatusAgendamento    @default(PENDENTE)
  criadoEm       DateTime             @default(now())
  empresa        Empresa?             @relation(fields: [empresaId], references: [id])
  empresaId      Int?
  cliente        Cliente?             @relation(fields: [clienteId], references: [id])
  clienteId      Int?
  profissional   Profissional?        @relation(fields: [profissionalId], references: [id])
  profissionalId Int?
  servicos       AgendamentoServico[]
  pagamento      Pagamento?

  @@map("agendamentos")
}

model AgendamentoServico {
  precoCobrado  Float
  servico       Servico?     @relation(fields: [servicoId], references: [id])
  servicoId     Int
  agendamento   Agendamento? @relation(fields: [agendamentoId], references: [id])
  agendamentoId Int

  @@id([agendamentoId, servicoId])
  @@map("agendamento_servicos")
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_DEBITO
  CARTAO_CREDITO
}

enum StatusPagamento {
  PENDENTE
  REALIZADO
}

model Pagamento {
  id             Int             @id @default(autoincrement())
  valorPago      Float?
  forma          FormaPagamento?
  status         StatusPagamento @default(PENDENTE)
  registradoEm   DateTime?
  criadoEm       DateTime        @default(now())
  empresa        Empresa?        @relation(fields: [empresaId], references: [id])
  empresaId      Int?
  agendamento    Agendamento     @relation(fields: [agendamentoId], references: [id])
  agendamentoId  Int             @unique

  @@map("pagamentos")
}

enum TipoNotificacaoInterna {
  ALTERACAO_HORARIO
}

model NotificacaoInterna {
  id            Int                    @id @default(autoincrement())
  tipo          TipoNotificacaoInterna
  entidadeId    Int
  mensagem      String
  criadoEm      DateTime               @default(now())
  empresa       Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId     Int

  @@unique([empresaId, tipo, entidadeId])
  @@map("notificacoes_internas")
}
